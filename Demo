import { UnitStatuses } from '@src/types/databaseSeedsType';

export const CB_RETAIL_MIGRATION_TO_DEVICE_SWAP: Partial<
  Record<UnitStatuses, UnitStatuses>
> = {
  [UnitStatuses.CB_RETAIL_MIGRATION_CANCELED]:
    UnitStatuses.DEVICE_SWAP_CANCELED,
  [UnitStatuses.CB_RETAIL_MIGRATION_COMPLETED]:
    UnitStatuses.DEVICE_SWAP_COMPLETED,
  [UnitStatuses.CB_RETAIL_MIGRATION_FAILED]:
    UnitStatuses.DEVICE_SWAP_FAILED,
  [UnitStatuses.CB_RETAIL_MIGRATION_PENDING]:
    UnitStatuses.DEVICE_SWAP_PENDING,
};

export const shouldTreatCbRetailAsDeviceSwap = (
  isHsdRetail: boolean,
  hasMigration: boolean,
): boolean => isHsdRetail && !hasMigration;

export const getUnitStatusDisplayStatus = (
  status: UnitStatuses,
  hasMigration: boolean,
  isHsdRetail: boolean,
): UnitStatuses => {
  if (!shouldTreatCbRetailAsDeviceSwap(isHsdRetail, hasMigration)) {
    return status;
  }

  return CB_RETAIL_MIGRATION_TO_DEVICE_SWAP[status] ?? status;
};

export const getUnitStatusI18nKey = (
  status: string | null | undefined,
  hasMigration: boolean,
  isHsdRetail: boolean,
): string | undefined => {
  if (!status) {
    return undefined;
  }

  const displayStatus: UnitStatuses = getUnitStatusDisplayStatus(
    status as UnitStatuses,
    hasMigration,
    isHsdRetail,
  );

  return Object.entries(UnitStatuses).find(
    ([, value]: [string, UnitStatuses]) => value === displayStatus,
  )?.[0];
};

export const matchesStatusFilter = (
  unitStatus: string | null | undefined,
  selectedStatuses: readonly string[],
  hasMigration: boolean,
  isHsdRetail: boolean,
): boolean => {
  if (selectedStatuses.length === 0) {
    return true;
  }

  if (!unitStatus) {
    return false;
  }

  const displayStatus: UnitStatuses = getUnitStatusDisplayStatus(
    unitStatus as UnitStatuses,
    hasMigration,
    isHsdRetail,
  );

  return selectedStatuses.includes(displayStatus);
};

export default getUnitStatusDisplayStatus;


